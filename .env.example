# Public application configuration.
NEXT_PUBLIC_APP_NAME=PrintChum
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WebMCP is enabled unless this is set to false, 0, or off.
NEXT_PUBLIC_WEBMCP_ENABLED=true

# Optional public Sentry configuration. Do not put server credentials here.
NEXT_PUBLIC_SENTRY_DSN=

# Reserved for future integrations. Keep real credentials in Vercel or a local
# ignored environment file, never in source control.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
